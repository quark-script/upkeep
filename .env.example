# Optional. Leave these empty and Upkeep runs fully offline, with everything in the browser.
# For sign-in and sync, copy to .env and fill in from your Supabase project (Project Settings >
# API Keys). The publishable key is meant for browsers: row level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
